{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",      // Используем компактный small-логотип вместо огромного
        "color": {
            "1": "white",     // Делаем обе части логотипа белыми/серыми
            "2": "white"
        },
        "padding": {
            "top": 1,
            "left": 2
        }
    },
    "display": {
        "separator": " ── ",
        "color": "white"
    },
    "modules": [
        {
            "type": "title",
            "keyWidth": 10,
            "color": {
                "user": "white",
                "host": "white"
            }
        },
        "break",
        { "type": "os", "key": "os  ", "keyColor": "white" },
        { "type": "kernel", "key": "ker ", "keyColor": "white" },
        { "type": "uptime", "key": "upt ", "keyColor": "white" },
        { "type": "shell", "key": "sh  ", "keyColor": "white" },
        { "type": "terminal", "key": "term", "keyColor": "white" },
        "break",
        { "type": "cpu", "key": "cpu ", "keyColor": "white", "format": "{1}" }, // Показывает только чистое имя процессора
        { "type": "gpu", "key": "gpu ", "keyColor": "white", "format": "{2}" }, // Показывает модель графики AMD
        { "type": "memory", "key": "mem ", "keyColor": "white" },
        "break"
    ]
}
